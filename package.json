{
	"name": "@cldmv/vitest-runner",
	"version": "1.3.0",
	"description": "Sequential Vitest runner to avoid OOM issues with large test suites",
	"type": "module",
	"main": "index.cjs",
	"module": "index.mjs",
	"types": "./types/index.d.mts",
	"exports": {
		".": {
			"types": "./types/index.d.mts",
			"import": "./index.mjs",
			"require": "./index.cjs"
		}
	},
	"bin": {
		"vitest-runner": "./bin/vitest-runner.mjs"
	},
	"files": [
		"index.mjs",
		"index.cjs",
		"types/",
		"src/",
		"bin/"
	],
	"scripts": {
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"format": "prettier --write . --config .configs/.prettierrc",
		"format:check": "prettier --check . --config .configs/.prettierrc",
		"test": "vitest run --config .configs/vitest.config.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:coverage": "vitest run --coverage --config .configs/vitest.config.mjs",
		"ci:coverage": "vitest run --coverage --reporter=dot --maxWorkers=1 --config .configs/vitest.config.mjs",
		"types:build": "tsc -p .configs/tsconfig.json",
		"types:check": "tsc -p .configs/tsconfig.json --noEmit",
		"build:ci": "npm run lint && npm run format:check && npm run types:build"
	},
	"keywords": [
		"vitest",
		"test-runner",
		"sequential",
		"oom"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.0",
		"@eslint/markdown": "^8.0.2",
		"@types/node": "^25.3.0",
		"@vitest/coverage-v8": "^4.1.9",
		"eslint": "^10.5.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"typescript": "^5.9.3",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"chalk": "^5.4.1"
	},
	"peerDependencies": {
		"vitest": ">=1.0.0"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
